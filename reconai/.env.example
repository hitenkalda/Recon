# ─── Database (Supabase) ────────────────────────────────────
# DATABASE_URL is the transaction-pooler (port 6543) for runtime queries.
# DIRECT_URL is the direct connection (port 5432) for Prisma Migrate.
# Swap ports if Supabase provides them; Prisma requires DIRECT_URL for schema pushes.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres?sslmode=require"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Storage (MinIO / S3-compatible) ─────────────────────────
STORAGE_ENDPOINT="localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="reconai-documents"
STORAGE_USE_SSL="false"
STORAGE_REGION="us-east-1"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="24h"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# ─── AI Providers ────────────────────────────────────────────
# Primary: Gemini Flash
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Fallback 1: Qwen via Groq
GROQ_API_KEY=""
GROQ_MODEL="qwen-2.5-32b"

# ─── Python Engine ──────────────────────────────────────────
PYTHON_SERVICE_URL="http://localhost:8000"

# ─── App ─────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
API_PORT="3001"
WEB_URL="http://localhost:3000"

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"

# ─── File Limits ─────────────────────────────────────────────
MAX_FILE_SIZE_MB="50"
MAX_FILES_PER_UPLOAD="10"